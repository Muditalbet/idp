// IDP control-plane data model — the single source of truth that the
// reconciler continuously drives the live cluster towards (GitOps style).

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Identity & ownership ──────────────────────────

enum Role {
  DEVELOPER
  PLATFORM_ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(DEVELOPER)
  teamId       String?
  team         Team?    @relation(fields: [teamId], references: [id])
  services     Service[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Team {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  users     User[]
  services  Service[]
  createdAt DateTime  @default(now())
}

// ──────────────────────────── Service catalog ──────────────────────────────

model Service {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  description  String        @default("")
  // Git repository the CI/CD pipeline builds from.
  repoUrl      String
  defaultBranch String       @default("main")
  // Scaffolder template the service was created from.
  template     String        @default("node-service")
  // Port the container listens on (used for Service + probes).
  containerPort Int          @default(8080)
  teamId       String
  team         Team          @relation(fields: [teamId], references: [id])
  ownerId      String
  owner        User          @relation(fields: [ownerId], references: [id])
  environments Environment[]
  pipelineRuns PipelineRun[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// ─────────────────────── Environments & GitOps state ───────────────────────

enum SyncStatus {
  UNKNOWN
  SYNCED
  OUT_OF_SYNC
}

enum HealthStatus {
  UNKNOWN
  PROGRESSING
  HEALTHY
  DEGRADED
  MISSING
}

model Environment {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  // Logical environment name: dev, staging, prod, ...
  name      String
  // Kubernetes namespace this environment lives in (globally unique).
  namespace String  @unique
  // Public ingress hostname, e.g. payments-dev.127.0.0.1.nip.io
  host      String

  // ─── Desired state (what the reconciler drives the cluster towards) ───
  desiredImage String?
  replicas     Int     @default(1)
  // Last rendered manifest bundle, kept for transparency / drift diffing.
  desiredManifest Json?

  // ─── Observed GitOps state (ArgoCD-style) ───
  syncStatus       SyncStatus   @default(UNKNOWN)
  healthStatus     HealthStatus @default(UNKNOWN)
  lastReconciledAt DateTime?
  reconcileError   String?

  claim         Claim?
  deployments   Deployment[]
  pipelineRuns  PipelineRun[]
  metricSamples MetricSample[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceId, name])
}

// ─────────────────── Infra claims (Crossplane-style) ────────────────────────

enum ClaimStatus {
  PENDING
  PROVISIONING
  PROVISIONED
  FAILED
}

model Claim {
  id            String      @id @default(cuid())
  environmentId String      @unique
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  status        ClaimStatus @default(PENDING)
  message       String?
  // What the provisioner created: namespace, quota, networkpolicy, ingress...
  resources     Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ─────────────────────────────── Deployments ───────────────────────────────

enum DeploymentStatus {
  PENDING
  DEPLOYING
  DEPLOYED
  FAILED
  ROLLED_BACK
  SUPERSEDED
}

model Deployment {
  id            String           @id @default(cuid())
  environmentId String
  environment   Environment      @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  image         String
  commitSha     String?
  commitMessage String?
  status        DeploymentStatus @default(PENDING)
  pipelineRunId String?          @unique
  pipelineRun   PipelineRun?     @relation(fields: [pipelineRunId], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([environmentId, createdAt])
}

// ───────────────────────────── CI/CD pipeline ──────────────────────────────

enum PipelineTrigger {
  MANUAL
  WEBHOOK
  ROLLBACK
}

enum PipelineStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  CANCELED
}

enum PipelineStep {
  QUEUE
  CLONE
  BUILD
  PUSH
  DEPLOY
}

model PipelineRun {
  id            String          @id @default(cuid())
  serviceId     String
  service       Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  environmentId String
  environment   Environment     @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  trigger       PipelineTrigger @default(MANUAL)
  status        PipelineStatus  @default(QUEUED)
  commitSha     String?
  commitMessage String?
  image         String?
  triggeredById String?
  startedAt     DateTime?
  finishedAt    DateTime?
  logs          PipelineLog[]
  deployment    Deployment?
  createdAt     DateTime        @default(now())

  @@index([serviceId, createdAt])
}

model PipelineLog {
  id            String       @id @default(cuid())
  pipelineRunId String
  pipelineRun   PipelineRun  @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)
  step          PipelineStep
  level         String       @default("info")
  message       String
  ts            DateTime     @default(now())

  @@index([pipelineRunId, ts])
}

// ───────────────────────────── Observability ───────────────────────────────

model MetricSample {
  id            String      @id @default(cuid())
  environmentId String
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  // e.g. http_requests_per_sec, p95_latency_ms, cpu_millicores, memory_mb, replicas_ready
  name          String
  value         Float
  ts            DateTime    @default(now())

  @@index([environmentId, name, ts])
}

// ─────────────────────────────── Audit log ─────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ts         DateTime @default(now())

  @@index([ts])
}
