# ─────────────────────────────────────────────────────────────────────────────
# IDP environment configuration. Copy to `.env` and adjust as needed.
# `npm run setup` reads these values; defaults below work for local development.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# Postgres (provisioned by docker-compose)
POSTGRES_USER=idp
POSTGRES_PASSWORD=idp
POSTGRES_DB=idp
DATABASE_URL=postgresql://idp:idp@localhost:5432/idp?schema=public

# Redis (provisioned by docker-compose) — BullMQ queues + pub/sub log bus
REDIS_URL=redis://localhost:6379

# Control-plane API
API_PORT=4000
# Secret used to sign JWTs. CHANGE THIS in any non-local environment.
JWT_SECRET=dev-only-change-me-super-secret
# Secret shared with GitHub for webhook HMAC verification.
GITHUB_WEBHOOK_SECRET=dev-webhook-secret

# Next.js portal
PORTAL_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Kubernetes / cluster
# kind cluster name and kubeconfig context used by the control plane.
KIND_CLUSTER_NAME=idp
KUBE_CONTEXT=kind-idp
# Local image registry wired into the kind cluster.
REGISTRY=localhost:5001
# Base domain for app ingress hostnames. nip.io resolves *.127.0.0.1.nip.io -> 127.0.0.1
# so no hosts-file edits are required on Windows.
INGRESS_DOMAIN=127.0.0.1.nip.io

# Local directory the pipeline uses to clone repos + build images.
IDP_WORKSPACE_DIR=.idp-workspace
